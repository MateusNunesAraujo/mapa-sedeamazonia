// Reglas de seguridad de Cloud Firestore para AVIAMAZ (cuentas de usuario).
// No se despliegan solas: copiar este contenido en la consola de Firebase →
// Firestore Database → Reglas → Publicar.
//
// users/{uid}         perfil público mínimo: nombreCompleto, username, email, proveedor, fotoURL, creado
// usernames/{name}    { uid } — reserva el nombre de usuario; como no se permite "update",
//                     escribir sobre uno que ya existe falla y así el username queda único.
// progreso/{uid}      respaldo privado del progreso del juego (un solo documento por usuario).
// actividad/{id}      actividad pública de la comunidad (actividad.js): 'union', 'logro', 'plantacion',
//                     con reacciones { uid: 'corazon' | 'planta' | 'asombro' | 'aplauso' }.
// jardines/{uid}      copia pública del jardín (jardin-publico.js): jardin, stats, logros, publico y
//                     likes { uid: true }. Sin monedas, inventario ni nada privado.
rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    match /users/{uid} {
      allow read: if request.auth != null;
      // actividadPublica: interruptor "Mostrar mi actividad en la comunidad" (opcional, booleano)
      allow create, update: if request.auth != null && request.auth.uid == uid
        && (!('actividadPublica' in request.resource.data) || request.resource.data.actividadPublica is bool);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    match /usernames/{name} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && name.matches('^[a-z0-9_.]{3,20}$');
      allow update: if false;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    // Progreso del juego (sincronizacion.js): privado, solo lo lee y escribe su dueño
    match /progreso/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.esquema is int
        && request.resource.data.monedas.plata is int
        && request.resource.data.monedas.plata >= 0
        && request.resource.data.monedas.oro is int
        && request.resource.data.monedas.oro >= 0
        && request.resource.data.arboles is list
        && request.resource.data.arboles.size() <= 500;
    }
    // Actividad de la comunidad (actividad.js). Solo se crea (no se edita): un segundo intento con el
    // mismo ID fijo ({uid}_union, {uid}_logro_{id}) falla y así no se duplica.
    // `fecha` son los ms del celular (el plugin 5.4.1 no trae serverTimestamp): se rechaza si está más de
    // 10 min en el futuro, para que nadie se ponga siempre arriba. El username debe ser el de su perfil.
    match /actividad/{id} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.tipo in ['union', 'logro', 'plantacion']
        && request.resource.data.reacciones == {}
        && request.resource.data.keys().hasOnly(
             ['tipo', 'uid', 'username', 'fotoURL', 'fecha', 'fechaEvento', 'logro', 'arbol', 'reacciones'])
        && request.resource.data.fecha is int
        && request.resource.data.fecha <= request.time.toMillis() + 600000
        && request.resource.data.fechaEvento is int
        && request.resource.data.username is string
        && request.resource.data.username
             == get(/databases/$(db)/documents/users/$(request.auth.uid)).data.username
        && (!('fotoURL' in request.resource.data)
            || (request.resource.data.fotoURL is string && request.resource.data.fotoURL.size() <= 500))
        && (request.resource.data.tipo != 'logro' || request.resource.data.logro is map)
        && (request.resource.data.tipo != 'plantacion' || request.resource.data.arbol is map);

      // Reaccionar: solo se puede tocar el campo 'reacciones' y solo la propia clave
      allow update: if request.auth != null
        && resource.data.uid != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reacciones'])
        && request.resource.data.reacciones.diff(resource.data.reacciones)
             .affectedKeys().hasOnly([request.auth.uid])
        && (!(request.auth.uid in request.resource.data.reacciones)
            || request.resource.data.reacciones[request.auth.uid]
                 in ['corazon', 'planta', 'asombro', 'aplauso']);

      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    // Copia pública del jardín (jardin-publico.js): se visita desde la pestaña Social y recibe "me gusta".
    // El dueño nunca escribe `likes` (solo lo crea vacío); cada visitante solo pone o quita su propia clave.
    match /jardines/{uid} {
      // resource == null: leer uno que no existe responde "no existe" en vez de "sin permiso"
      allow read: if request.auth != null
        && (resource == null || request.auth.uid == uid || resource.data.publico == true);

      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.likes == {}
        && request.resource.data.publico is bool;

      allow update: if request.auth != null && (
        // El dueño actualiza su jardín, pero nunca los likes
        (request.auth.uid == uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['likes'])
          && (!('publico' in request.resource.data) || request.resource.data.publico is bool))
        ||
        // Otro usuario solo puede poner o quitar SU propio like en un jardín público
        (request.auth.uid != uid
          && resource.data.publico == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
          && request.resource.data.likes.diff(resource.data.likes).affectedKeys().hasOnly([request.auth.uid])
          && (!(request.auth.uid in request.resource.data.likes)
              || request.resource.data.likes[request.auth.uid] == true))
      );

      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
