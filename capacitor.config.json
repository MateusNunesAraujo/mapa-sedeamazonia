{
  "appId": "com.universidadnacional.mapasedeamazonia",
  "appName": "Mapa Sede Amazonia",
  "webDir": "www",
  "ios": {
    "contentInsetAdjustmentBehavior": "automatic"
  },
  "android": {
    "allowMixedContent": true,
    "webContentsDebuggingEnabled": true
  },
  "plugins": {
    "Filesystem": {
      "permissions": [
        "PUBLIC_STORAGE",
        "PUBLIC_DOCUMENTS"
      ]
    }
  }
}